@page
@model EditProductModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Edit Product</h1>
            <p>Update the information for this product.</p>
        </div>
    </div>

    <div class="product-form-container">

        <form method="post">

            <input type="hidden" asp-for="Product.ProductID" />

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Product.Barcode">Barcode</label>
                <input asp-for="Product.Barcode" class="form-control" />
                <span asp-validation-for="Product.Barcode" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.ProductName">Product Name</label>
                <input asp-for="Product.ProductName" class="form-control" />
                <span asp-validation-for="Product.ProductName" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.Category">Category</label>
                <input asp-for="Product.Category" class="form-control" />
                <span asp-validation-for="Product.Category" class="validation-error"></span>
            </div>

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="Product.Price">Price</label>
                    <input asp-for="Product.Price"
                           type="number"
                           step="0.01"
                           class="form-control" />
                    <span asp-validation-for="Product.Price" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Product.Quantity">Quantity</label>
                    <input asp-for="Product.Quantity"
                           type="number"
                           class="form-control" />
                    <span asp-validation-for="Product.Quantity" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Product.MinimumStock">Minimum Stock</label>
                    <input asp-for="Product.MinimumStock"
                           type="number"
                           class="form-control" />
                    <span asp-validation-for="Product.MinimumStock" class="validation-error"></span>
                </div>

            </div>

            <button type="submit" class="primary-button">
                Save Changes
            </button>

            <a asp-page="/Inventory" class="secondary-button">
                Cancel
            </a>

        </form>

    </div>

</div>