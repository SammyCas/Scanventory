@page
@model DeleteProductModel
@{
    ViewData["Title"] = "Delete Product";
}

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Delete Product</h1>
            <p>Confirm that you want to remove this product.</p>
        </div>
    </div>

    <div class="product-form-container">

        <h2>Are you sure?</h2>

        <p>
            You are about to delete:
            <strong>@Model.Product.ProductName</strong>
        </p>

        <p>
            Barcode: @Model.Product.Barcode
        </p>

        <form method="post">

            <input type="hidden" asp-for="Product.ProductID" />

            <button type="submit" class="delete-button">
                Yes, Delete Product
            </button>

            <a asp-page="/Inventory" class="secondary-button">
                Cancel
            </a>

        </form>

    </div>

</div>