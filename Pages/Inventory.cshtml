@page
@model InventoryModel
@{
    ViewData["Title"] = "Inventory";
}

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Inventory</h1>
            <p>View and manage your current stock.</p>
        </div>
    </div>

    @if (Model.Products.Count == 0)
    {
        <div class="empty-state">
            <h2>No products found</h2>
            <p>Your inventory is currently empty.</p>
        </div>
    }
    else
    {
        <div class="inventory-filters">

            <form method="get">

                <div class="form-group">
                    <label for="SearchTerm">Search</label>
                    <input type="text"
                           id="SearchTerm"
                           name="SearchTerm"
                           value="@Model.SearchTerm"
                           placeholder="Search by name, barcode or category..." />
                </div>

                <div class="form-group">
                    <label for="CategoryFilter">Category</label>

                    <select id="CategoryFilter"
                            name="CategoryFilter">

                        <option value="">All Categories</option>

                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category"
                                    selected="@(Model.CategoryFilter == category)">
                                 @category
                            </option>
                        }

                    </select>
                </div>

                <button type="submit" class="action-button edit">
                    Search
                </button>

                <a asp-page="/Inventory" class="action-button">
                    Clear
                </a>

            </form>

        </div>
        <div class="inventory-table-container">

            <table class="inventory-table">

                <thead>
                    <tr>
                        <th>Barcode</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Stock Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var product in Model.Products)
                    {
                        <tr>

                            <td>@product.Barcode</td>

                            <td>
                                <strong>@product.ProductName</strong>
                            </td>

                            <td>@product.Category</td>

                            <td>R @product.Price.ToString("0.00")</td>

                            <td>@product.Quantity</td>

                            <td>
                                @if (product.Quantity == 0)
                                {
                                    <span class="stock-badge out">
                                        Out of Stock
                                    </span>
                                }
                                else if (product.Quantity <= product.MinimumStock)
                                {
                                    <span class="stock-badge low">
                                        Low Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="stock-badge good">
                                        In Stock
                                    </span>
                                }
                            </td>
                            <td>
                                 <a asp-page="/EditProduct"
                                    asp-route-id="@product.ProductID"
                                    class="action-button edit">
                                     Edit
                                 </a>

                                 <a asp-page="/DeleteProduct"
                                    asp-route-id="@product.ProductID"
                                    class="action-button delete">
                                     Delete
                                 </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>